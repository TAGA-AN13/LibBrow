# Use your Supabase PostgreSQL connection string. For a deployed app, use the
# Supabase pooler URL and its required SSL settings; keep this value private.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
PORT=3000
WEB_ORIGIN=http://localhost:5173,http://localhost:5174
JWT_SECRET="replace-with-at-least-32-random-bytes"
JWT_EXPIRES_IN=1h
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
ADMIN_BOOTSTRAP_KEY="replace-with-a-unique-random-secret-of-at-least-32-bytes"
